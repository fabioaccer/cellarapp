# API Configuration
API_BASE_URL=https://fakestoreapi.com

# Firebase Configuration
# Obtenha essas configurações em: https://console.firebase.google.com/
# Vá em Configurações do projeto > Geral > Seus apps > Web
EXPO_PUBLIC_FIREBASE_API_KEY=sua_api_key_aqui
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu_projeto_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu_projeto.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Firebase Cloud Messaging (Opcional - para usar FCM)
# EXPO_PUBLIC_FIREBASE_VAPID_KEY=sua_vapid_key_aqui
